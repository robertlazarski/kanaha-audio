# Private keys and certificates - NEVER commit these.
# Certs/keys are generated per-deployment (see docs/SECURITY.md); a fresh clone
# generates its own. The shared demo CA + client cert live in the Kanaha Camera repo.
*.key
*.pem
*.crt
*.csr
*.srl
*.p12
*.pfx
*.jks
*.keystore
known_hosts
servers.json

# Build artifacts
build-android/
*.o
*.so
*.a

# Test data (contains user recordings — never commit)
test-data/

# IDE and editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Android build
.gradle/
build/
local.properties

# OS files
.DS_Store
Thumbs.db
